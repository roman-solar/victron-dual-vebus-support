+    @staticmethod
+    def _max_cross_vebus_transfer(sources, loads):
+        if not sources or not loads:
+            return 0
+
+        source_total = sum(sources.values())
+        load_total = sum(loads.values())
+        services = set(sources) | set(loads)
+        largest_self_pair = max(
+            sources.get(service, 0) + loads.get(service, 0)
+            for service in services)
+
+        # Exclude conversion that occurs within the same VE.Bus service.
+        return max(0, min(
+            source_total,
+            load_total,
+            source_total + load_total - largest_self_pair))
+
+    def _update_cross_vebus_transfer(self, rawdeltas, refreshbaseline):
+        current = {}
+        instances = {}
+
+        for service, values in rawdeltas.items():
+            if not service.startswith('com.victronenergy.vebus.'):
+                continue
+
+            instance = next((item[0] for item in values.values()), None)
+            if instance is None:
+                continue
+            instances[service] = instance
+
+            def raw(path):
+                item = values.get(path)
+                return item[1] if item is not None else 0
+
+            current[service] = {
+                'in1': raw('/Energy/AcIn1ToInverter'),
+                'in2': raw('/Energy/AcIn2ToInverter'),
+                'out': raw('/Energy/InverterToAcOut'),
+            }
+
+        interval = {}
+        for service, values in current.items():
+            previous = self._cross_vebus_previous.get(service, {})
+            interval[service] = {}
+            for key, value in values.items():
+                old = previous.get(key, 0)
+                interval[service][key] = value - old if value >= old else value
+
+        grid_sources = {}
+        genset_sources = {}
+        loads = {}
+
+        for service, values in interval.items():
+            if values['out'] > 0:
+                loads[service] = values['out']
+
+            instance = instances[service]
+            for input_number, key in ((1, 'in1'), (2, 'in2')):
+                source = values[key]
+                if source <= 0:
+                    continue
+
+                role = self._dbusdeltas.get_vebus_input_type(instance, input_number)
+                target = grid_sources if role == 1 else genset_sources
+                target[service] = target.get(service, 0) + source
+
+        # rawdeltas are cumulative from the current VRM baseline. Match only
+        # increments from the same vrmlogger sampling interval, then accumulate
+        # the matched transfer for that baseline.
+        self._cross_vebus_grid += self._max_cross_vebus_transfer(
+            grid_sources, loads)
+        self._cross_vebus_genset += self._max_cross_vebus_transfer(
+            genset_sources, loads)
+
+        result = self._cross_vebus_grid, self._cross_vebus_genset
+
+        if refreshbaseline:
+            self._cross_vebus_previous = {}
+            self._cross_vebus_grid = 0
+            self._cross_vebus_genset = 0
+        else:
+            self._cross_vebus_previous = current
+
+        return result
+
