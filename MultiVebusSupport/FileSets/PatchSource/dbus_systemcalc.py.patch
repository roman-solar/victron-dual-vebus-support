+	def _load_acload_authoritative_instance(self):
+		try:
+			with open(self.MULTI_VEBUS_CONFIG, 'r') as f:
+				config = json.load(f).get('ac_load_authoritative', {})
+			if config.get('enabled') is not True:
+				return None
+			return int(config['device_instance'])
+		except (OSError, AttributeError, KeyError, TypeError, ValueError):
+			return None
+
+	def _get_authoritative_acload_service(self):
+		# Only configure this for a meter that measures the complete system AC
+		# load. A meter on an individual branch must use the normal calculation.
+		if self._acload_authoritative_instance is None:
+			return None
+
+		for service, instance in self._get_connected_service_list('com.victronenergy.acload').items():
+			if instance == self._acload_authoritative_instance:
+				return service
+		return None
